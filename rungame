#!/bin/bash
# Get the directory of this script
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

# Configure ROS 2 Domain ID (Check local .domain_id file, then environment, fallback to 0)
if [ -f "$DIR/.domain_id" ]; then
    export ROS_DOMAIN_ID=$(cat "$DIR/.domain_id" | tr -d '[:space:]')
else
    export ROS_DOMAIN_ID=${ROS_DOMAIN_ID:-0}
fi

# Source ROS 2 Humble
if [ -f /opt/ros/humble/setup.bash ]; then
    source /opt/ros/humble/setup.bash
fi

# Build if build/install directories don't exist
if [ ! -d "install" ] || [ ! -f "install/setup.bash" ]; then
    echo "First time build. Running colcon build..."
    colcon build --symlink-install
fi

source install/setup.bash

if [ "$1" = "server" ]; then
    echo "Clearing any orphaned game logic servers..."
    pkill -f game_logic 2>/dev/null || true
    sleep 0.5
    echo "Starting Game Logic Server..."
    ros2 run arena_battle game_logic
else
    echo "Clearing any orphaned client visualizers..."
    pkill -f pygame_visualizer 2>/dev/null || true
    sleep 0.5
    echo "Starting Arena Battle Client..."
    ros2 run arena_battle pygame_visualizer
fi

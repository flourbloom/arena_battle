#!/bin/bash
# Get the directory of this script
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

export ROS_DOMAIN_ID=67

# Source ROS 2 Humble
if [ -f /opt/ros/humble/setup.bash ]; then
    source /opt/ros/humble/setup.bash
fi

# Selective cleanup: only kill the type of process we are about to start
if [ "$1" = "server" ]; then
    echo "[Cleanup] Killing any existing game_logic server processes..."
    pkill -9 -f "arena_battle.*game_logic" 2>/dev/null || true
else
    echo "[Cleanup] Killing any existing pygame_visualizer client processes..."
    pkill -9 -f "arena_battle.*pygame_visualizer" 2>/dev/null || true
fi
sleep 0.3

# Build workspace (only if needed)
if [ ! -d "install" ] || [ ! -f "install/setup.bash" ]; then
    echo "[Build] First time build. Running colcon build..."
    colcon build --symlink-install
else
    echo "[Build] Incremental build..."
    colcon build --symlink-install
fi

source install/setup.bash

echo "[Info] ROS_DOMAIN_ID=$ROS_DOMAIN_ID"

if [ "$1" = "server" ]; then
    echo "[Start] Launching Game Logic Server..."
    ros2 run arena_battle game_logic
elif [ "$1" = "p1" ]; then
    echo "[Start] Launching Arena Battle Client P1..."
    ros2 run arena_battle pygame_visualizer --ros-args -r __ns:=/p1
elif [ "$1" = "p2" ]; then
    echo "[Start] Launching Arena Battle Client P2..."
    ros2 run arena_battle pygame_visualizer --ros-args -r __ns:=/p2
else
    echo "[Start] Launching Arena Battle Client..."
    ros2 run arena_battle pygame_visualizer
fi
